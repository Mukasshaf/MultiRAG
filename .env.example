PINECONE_API_KEY=
PINECONE_INDEX_NAME=multirag
PINECONE_REGION=us-east-1


OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b


TOP_K_RESULTS=5
DATA_DIR=data

# ── RAGAS Judge Provider ───────────────────────────────────────────────────────
# Set RAGAS_JUDGE to any one of: ollama, openrouter, nvidia, omnirouter
RAGAS_JUDGE=ollama
RAGAS_JUDGE_MODEL=

# OpenRouter  (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free

# NVIDIA NIM  (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_JUDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OmniRouter  (set base_url to your OmniRouter endpoint)
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=https://api.omnirouter.ai/v1
OMNIROUTER_JUDGE_MODEL=antigravity/gemini-3.8-flash-high

